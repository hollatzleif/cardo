{
  "name": "10-query-semantics",
  "description": "Query = SQLite json_extract semantics: LIKE is a substring match ('%'||v||'%') where % and _ in v are wildcards and case folding is ASCII-only; missing/null fields are NULL (never match =, !=, <, LIKE); numbers sort/compare before text (no coercion); booleans are 1/0; ORDER BY puts NULL first ascending, text compares by UTF-8 bytes; deleted docs and other namespaces never appear. Unordered results compare as sets.",
  "steps": [
    {
      "kind": "set",
      "namespace": "q",
      "id": "q1",
      "value": {
        "title": "Rabatt 50% heute",
        "n": 10,
        "s": "10",
        "tag": "a",
        "done": true,
        "f": 2.5
      }
    },
    {
      "kind": "set",
      "namespace": "q",
      "id": "q2",
      "value": {
        "title": "Rabatt 500 Euro",
        "n": 2,
        "s": "9",
        "tag": "b",
        "done": false,
        "f": -1
      }
    },
    {
      "kind": "set",
      "namespace": "q",
      "id": "q3",
      "value": {
        "title": "abc_def",
        "n": null,
        "tag": "a"
      }
    },
    {
      "kind": "set",
      "namespace": "q",
      "id": "q4",
      "value": {
        "title": "ABCxDEF",
        "n": "7",
        "tag": "c"
      }
    },
    {
      "kind": "set",
      "namespace": "q",
      "id": "q5",
      "value": {
        "title": "Ärger über Öl",
        "n": -5,
        "tag": "b",
        "done": true
      }
    },
    {
      "kind": "set",
      "namespace": "q",
      "id": "q6",
      "value": {
        "tag": "a",
        "n": 1
      }
    },
    {
      "kind": "delete",
      "namespace": "q",
      "id": "q6",
      "expectOpsLogged": 1
    },
    {
      "kind": "set",
      "namespace": "other",
      "id": "o1",
      "value": {
        "tag": "a",
        "n": 1
      }
    },
    {
      "kind": "query",
      "namespace": "q",
