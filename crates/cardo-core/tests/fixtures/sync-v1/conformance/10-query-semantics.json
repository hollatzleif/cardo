      "namespace": "q",
      "query": {
        "where": [
          {
            "field": "title",
            "op": "like",
            "value": "50%"
          }
        ]
      },
      "expectRows": [
        {
          "title": "Rabatt 50% heute",
          "n": 10,
          "s": "10",
          "tag": "a",
