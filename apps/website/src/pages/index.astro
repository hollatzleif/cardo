---
/**
 * The whole site, on one page.
 *
 * It is laid out as a Cardo board rather than as a marketing page: the app's
 * own top bar, its own 12-column / 56 px grid, its own widget chrome. Each
 * topic is introduced by a widget you can actually operate — the assistant
 * proposes and waits for a yes, the flashcard grades and reschedules, sync
 * shows the ciphertext next to the plaintext, the self-test runs. Reading
 * about those things never landed; using them does.
 *
 * Reference material that would drown the page (the model table, the tutorial
 * steps, the FAQs) sits in <details> next to the widget it belongs to.
 */
import Base from '../layouts/Base.astro';
import Board from '../components/Board.astro';
import TopBar from '../components/TopBar.astro';
import Widget from '../components/Widget.astro';
import AssistantWidget from '../components/widgets/AssistantWidget.astro';
import DiagnoseWidget from '../components/widgets/DiagnoseWidget.astro';
import FlashcardWidget from '../components/widgets/FlashcardWidget.astro';
import SyncWidget from '../components/widgets/SyncWidget.astro';
import ThemeWidget from '../components/widgets/ThemeWidget.astro';
import CopyBlock from '../components/CopyBlock.astro';
import Barometer from '../components/Barometer.astro';
import { GITHUB_USER, RELEASES_URL, FORUM_URL, withBase } from '../lib/site';

const installSh = `curl -fsSL https://${GITHUB_USER}.github.io/cardo-app/install.sh | sh`;
const installPs = `irm https://${GITHUB_USER}.github.io/cardo-app/install.ps1 | iex`;

const tools = [
  'To-dos', 'Notes', 'Calendar', 'Files', 'Flashcards', 'Statutes', 'Habits', 'Clock',
  'World clock', 'Pomodoro', 'Countdown', 'Alarm', 'Weather', 'Stats', 'Eisenhower',
  'Time blocking', 'Projects', 'OKRs', 'Scratchpad', 'Sticky notes', 'Decision log',
  'Reading list', 'Bookmarks', 'Snippets', 'Soundscapes', 'Breathing', 'Mood', 'Sleep log',
  'Workout', 'Meal planner', 'Medication', 'Savings jar', 'Subscriptions', 'Shared expenses',
  'Currency', 'Calculator', 'Unit converter', 'QR codes', 'Password generator',
  'Random picker', 'Colours', 'RSS', 'Counter', 'Hydration', 'Routine', 'Quick capture',
];
---

<Base title="Cardo – your personal, local-first dashboard" header={false}>
  <!-- ── The board is the page ──────────────────────────────────────── -->
  <section class="shell" id="board">
    <TopBar active="Start" />
    <Board>
      <Widget w={7} h={3} pages="start">
        <div class="wgt">
          <h1 class="lede">Everything in one place.<br />Arranged the way you want it.</h1>
          <p class="c-muted lede__sub">
            A local-first dashboard for macOS, Windows and Linux. Close to 50 tools as
            widgets on your own board — and this page is one of those boards.
          </p>
        </div>
      </Widget>

      <Widget w={5} h={3} accent={6} pages="start">
        <div class="wgt">
          <div class="wgt__head">
            <span class="c-badge c-badge--green">● Local</span>
            <span class="meta grow">44 of 46 tools</span>
          </div>
          <div class="wgt__body">
            <p class="c-muted small">
              Every tool carries a privacy light. Green means it works fully offline.
              Only two are yellow — and both name the host they talk to.
            </p>
            <div class="row mt"><span class="c-badge c-badge--yellow">● Internet</span>
              <span class="meta grow">Weather · open-meteo.com</span></div>
            <div class="row"><span class="c-badge c-badge--yellow">● Internet</span>
              <span class="meta grow">Assistant · huggingface.co</span></div>
          </div>
        </div>
      </Widget>

      <AssistantWidget pages="start focus" />

      <Widget w={4} h={3} pages="start work">
        <div class="wgt">
          <div class="wgt__head"><strong>Today</strong><span class="meta grow">2/5</span></div>
          <div class="wgt__body">
            <label class="row"><input type="checkbox" checked /><span class="grow done">Draft the contract</span></label>
            <label class="row"><input type="checkbox" checked /><span class="grow done">Review 24 cards</span></label>
            <label class="row"><input type="checkbox" /><span class="grow">Call the tax office</span><span class="meta">30.07.</span></label>
            <label class="row"><input type="checkbox" /><span class="grow">Tax return 2025</span><span class="meta overdue">28.07.</span></label>
            <label class="row"><input type="checkbox" /><span class="grow">Sort the notes folder</span></label>
          </div>
        </div>
      </Widget>

      <Widget w={3} h={3} accent={3} pages="start work focus">
        <div class="wgt clock">
          <div class="num clock__time" data-clock>09:41</div>
          <div class="c-muted small" data-date>Wednesday</div>
        </div>
      </Widget>

      <!-- ── Work board ─────────────────────────────────────────────── -->
      <Widget w={5} h={3} accent={4} pages="work">
        <div class="wgt">
          <div class="wgt__head"><strong>Projects</strong><span class="meta grow">3 active</span></div>
          <div class="wgt__body">
            <div class="row"><span class="grow">Client migration</span><span class="meta">72 %</span></div>
            <div class="bar"><span style="width:72%;background:var(--accent-4)"></span></div>
            <div class="row mt"><span class="grow">Q3 report</span><span class="meta">40 %</span></div>
            <div class="bar"><span style="width:40%;background:var(--accent-2)"></span></div>
          </div>
        </div>
      </Widget>

      <Widget w={4} h={3} accent={2} pages="work">
        <div class="wgt">
          <div class="wgt__head"><strong>Notes</strong><span class="meta grow">12 files</span></div>
          <div class="wgt__body">
            <div class="row"><span class="grow">Client migration — plan</span><span class="meta">2 h</span></div>
            <div class="row"><span class="grow">Meeting 28.07.</span><span class="meta">1 d</span></div>
            <div class="row"><span class="grow">[[Q3 report]]</span><span class="meta">3 d</span></div>
            <p class="c-muted small" style="margin-top:var(--space-2)">
              Plain Markdown in a folder you own — wiki-links, backlinks, LaTeX.
            </p>
          </div>
        </div>
      </Widget>

      <!-- ── Focus board ────────────────────────────────────────────── -->
      <Widget w={5} h={3} accent={2} pages="focus">
        <div class="wgt clock">
          <div class="num clock__time" style="color:var(--accent-2)">24:18</div>
          <div class="c-muted small">Pomodoro · 2 of 4</div>
          <div class="bar" style="width:100%;margin-top:var(--space-2)">
            <span style="width:34%;background:var(--accent-2)"></span>
          </div>
        </div>
      </Widget>

      <Widget w={4} h={3} accent={6} pages="focus">
        <div class="wgt">
          <div class="wgt__head"><strong>Habits</strong><span class="meta grow">4/6</span></div>
          <div class="wgt__body">
            <div class="heat">
              {Array.from({ length: 28 }).map((_, i) => (
                <span class={`heat__cell${i % 5 === 3 ? '' : ' heat__cell--on'}`}></span>
              ))}
            </div>
          </div>
        </div>
      </Widget>
    </Board>
  </section>

  <p class="board-note c-muted">
    That is not a picture. Operate the assistant, change the design — the page behaves
    like the app because it is built from the same pieces.
  </p>

  <!-- ── Assistant ──────────────────────────────────────────────────── -->
  <!-- Text only: the operable assistant lives on the board above, and Astro
       emits one script per component, so a second instance would render but
       never be wired. Anchored so /assistant lands here. -->
  <section class="topic topic--wide" id="assistant-detail">
    <div class="topic__text">
      <p class="eyebrow">Assistant</p>
      <h2>It proposes. You decide.</h2>
      <p class="prose">
        Dump your thoughts in and get back proposal cards — appointments, to-dos, notes,
        habits. <strong>Nothing is applied until you say yes.</strong> The model runs on
        your device; or bring your own Claude subscription if you want cloud power.
      </p>
      <p class="prose">
        Give an assistant a personality, working style and memory. Run several of them,
        put them in a team, let them delegate to each other.
      </p>

      <details class="disc">
        <summary>Which model should I pick?</summary>
        <div class="disc__body">
          <p>Roughly: more RAM buys a bigger model, and a bigger model understands more but
            answers slower. Cardo shows what fits your machine before you download anything.</p>
          <ul>
            <li><strong>8 GB RAM</strong> — a 3–4 B model, quick and fine for braindumps.</li>
            <li><strong>16 GB</strong> — 7–8 B, noticeably better at German and at longer texts.</li>
            <li><strong>32 GB and up</strong> — 12–14 B, or use Claude and keep the RAM.</li>
          </ul>
          <p>Apple Silicon is markedly faster than an equivalent Intel machine, because the
            model shares memory with the GPU.</p>
        </div>
      </details>
      <details class="disc">
        <summary>Is anything sent to a server?</summary>
        <div class="disc__body">
          <p>With a local model: no. The only network access is the one-time model download
            from <code>huggingface.co</code>, and it only happens when you press install.</p>
          <p>With Claude: yes — your prompt goes to Anthropic through the Claude Code CLI you
            installed and logged into yourself. Cardo marks that clearly, and it is never
            the default.</p>
        </div>
      </details>
      <details class="disc">
        <summary>Teams and delegation</summary>
        <div class="disc__body">
          <p>Several assistants can share a chat. A router decides who answers, and one can
            hand a question to another that knows the subject better. Each keeps its own
            memory and competences.</p>
        </div>
      </details>
      <p class="prose">
        <a href="#assistant">Try it on the board above ↑</a>
      </p>
    </div>
  </section>

  <!-- ── Tools & privacy ────────────────────────────────────────────── -->
  <section class="topic topic--wide" id="tools">
    <div class="topic__text">
      <p class="eyebrow">Tools</p>
      <h2>Close to 50 tools, and each one declares itself.</h2>
      <p class="prose">
        Green means the tool works fully offline. Yellow means it contacts the internet —
        and Cardo says in plain language what it sends and where, before anything happens.
        There is no third state and no fine print.
      </p>
    </div>
    <ul class="tools">
      {tools.map((t) => (
        <li class="tools__item"><span class="tools__dot" aria-hidden="true"></span>{t}</li>
      ))}
    </ul>
  </section>

  <!-- ── Flashcards ─────────────────────────────────────────────────── -->
  <section class="topic topic--flip" id="flashcards-detail">
    <div class="topic__text">
      <p class="eyebrow">Flashcards</p>
      <h2>Anki-class, without leaving your board.</h2>
      <p class="prose">
        Note types with templates and cloze deletions, the modern FSRS scheduler or classic
        SM-2, a card browser with Anki search syntax, statistics — and import or export of
        your existing <code>.apkg</code> decks. Media and LaTeX included. All fully local.
      </p>
      <p class="prose">Grade the card next to this and watch the interval change.</p>
    </div>
    <div class="topic__demo"><Board><FlashcardWidget /></Board></div>
  </section>

  <!-- ── Sync ───────────────────────────────────────────────────────── -->
  <section class="topic" id="sync-detail">
    <div class="topic__text">
      <p class="eyebrow">Sync</p>
      <h2>Optional. Off by default. Encrypted with a key only you hold.</h2>
      <p class="prose">
        Your to-dos, notes, settings and assistants on every device — carried by your own
        Google Drive, an iCloud or Dropbox folder, or a WebDAV server. Everything is
        encrypted on your device first, so whoever stores it holds unreadable blocks.
      </p>
      <p class="prose">
        Turn it on next to this and look at what the storage provider actually receives.
      </p>
    </div>
    <div class="topic__demo"><Board><SyncWidget /></Board></div>
  </section>

  <!-- ── Diagnostics ────────────────────────────────────────────────── -->
  <section class="topic topic--flip" id="diagnose-detail">
    <div class="topic__text">
      <p class="eyebrow">Diagnostics</p>
      <h2>The app checks itself, and shows its work.</h2>
      <p class="prose">
        One button runs over 400 checks — storage, sync crypto, every tool's self-test,
        every widget in every view — against a throwaway database, then hands you a
        readable report. If something is off you see exactly what, instead of filing a
        support ticket.
      </p>
    </div>
    <div class="topic__demo"><Board><DiagnoseWidget /></Board></div>
  </section>

  <!-- ── Design ─────────────────────────────────────────────────────── -->
  <section class="topic" id="design">
    <div class="topic__text">
      <p class="eyebrow">Design</p>
      <h2>Twenty themes. Try them on this page.</h2>
      <p class="prose">
        Themes, card styles, fonts, density and per-widget accents — Cardo adapts to how
        you want to look at it. The picker beside this is the real set that ships with the
        app, and it repaints this page as you click.
      </p>
    </div>
    <div class="topic__demo"><Board><ThemeWidget /></Board></div>
  </section>

  <!-- ── Download ───────────────────────────────────────────────────── -->
  <section class="section" id="download">
    <div>
      <p class="eyebrow">Download</p>
      <h2>Free, no account, no strings attached.</h2>
      <p class="prose">
        Installers for all three platforms are published on
        <a href={RELEASES_URL} rel="noopener">GitHub Releases</a>. The one-liner detects
        your system and fetches the latest one.
      </p>
    </div>

    <div class="installs">
      <div class="install">
        <h3>macOS and Linux</h3>
        <CopyBlock command={installSh} label="Terminal" />
      </div>
      <div class="install">
        <h3>Windows</h3>
        <CopyBlock command={installPs} label="PowerShell" />
      </div>
    </div>

    <details class="disc">
      <summary>macOS says the app is damaged or from an unidentified developer</summary>
      <div class="disc__body">
        <p>The builds are not notarised yet. Right-click the app in Finder and choose
          <strong>Open</strong>, then confirm once — after that it starts normally. Or run
          <code>xattr -dr com.apple.quarantine /Applications/Cardo.app</code>.</p>
      </div>
    </details>
    <details class="disc">
      <summary>Windows SmartScreen warns about an unknown publisher</summary>
      <div class="disc__body">
        <p>Same reason: no paid code-signing certificate. Click <strong>More info</strong>
          and then <strong>Run anyway</strong>. The installer is the file published on
          GitHub Releases and nothing else.</p>
      </div>
    </details>
  </section>

  <!-- ── Getting started ────────────────────────────────────────────── -->
  <section class="section" id="docs">
    <div>
      <p class="eyebrow">Getting started</p>
      <h2>From installed to “this is my place now”.</h2>
    </div>
    <ol class="steps">
      <li><strong>Say hi.</strong> The first start drops you on an empty board. Nothing to
        configure, no account, no wizard.</li>
      <li><strong>Press <kbd>⌘E</kbd></strong> (or <kbd>Ctrl E</kbd>) for edit mode. Now
        widgets get a title bar with a drag grip and a resize corner.</li>
      <li><strong>Add widgets</strong> from the tool market, place them, resize them. Keep
        separate pages for work, home and focus.</li>
      <li><strong>Press <kbd>⌘K</kbd></strong> for the command palette — every command in
        the app, one keystroke away.</li>
      <li><strong>Make it yours</strong> in the design panel: theme, card style, font,
        density, per-widget accents.</li>
      <li><strong>Run the self-test</strong> in the settings whenever something feels off.</li>
    </ol>

    <details class="disc">
      <summary>Where is my data?</summary>
      <div class="disc__body">
        <p>In an SQLite database in your user folder, plus your notes as plain
          <code>.md</code> files in a folder you picked yourself. Both readable with any
          other tool. There is no server holding a copy.</p>
      </div>
    </details>
    <details class="disc">
      <summary>Is it really free?</summary>
      <div class="disc__body">
        <p>Yes. No paywall, no premium tier, no “pro” version, no trial. Donations are
          voluntary and cover the running costs.</p>
      </div>
    </details>
    <details class="disc">
      <summary>Questions, bugs, ideas</summary>
      <div class="disc__body">
        <p>The <a href={FORUM_URL} rel="noopener">forum</a> is GitHub Discussions — no
          separate account needed if you already have one there.</p>
      </div>
    </details>
  </section>

  <!-- ── Donate ─────────────────────────────────────────────────────── -->
  <section class="section" id="donate">
    <div>
      <p class="eyebrow">Support</p>
      <h2>Free to use. Donations keep it running.</h2>
      <p class="prose">
        Cardo is free and will stay free. A voluntary donation covers this year’s running
        costs — domain, server, certificates. Shown as a percentage, never as amounts.
      </p>
      <Barometer />
      <p class="prose small">
        Donation channels are not live yet. When they are, they will appear here.
      </p>
    </div>
  </section>

  <style>
    /* ── The app shell ────────────────────────────────────────────────
       Breaks out of main's column so the board fills the window, exactly as
       the app does. overflow:hidden contains the 100vw child. */
    .shell {
      margin: -2rem calc(50% - 50vw) 0;
      border-bottom: 1px solid var(--border-subtle);
      background: var(--bg-canvas);
      overflow: hidden;
    }
    .shell :global(.canvas) {
      max-width: 1180px;
      margin: 0 auto;
      padding: var(--space-3) var(--space-4) var(--space-6);
    }

    .lede {
      font-size: clamp(1.6rem, 3.4vw, 2.5rem);
      font-weight: 600;
      letter-spacing: -0.03em;
      line-height: 1.1;
      margin: 0 0 var(--space-3);
      text-wrap: balance;
    }
    .lede__sub { margin: 0; max-width: 46ch; }

    .small { font-size: 0.85em; }
    .mt { margin-top: var(--space-2); }
    .done { text-decoration: line-through; color: var(--text-muted); }
    .overdue { color: var(--danger); }
    input[type='checkbox'] { accent-color: var(--accent); flex: none; }
    label.row { cursor: pointer; padding: 2px 0; }
    .clock { align-items: center; justify-content: center; text-align: center; }
    .clock__time { font-size: 2.2em; font-weight: 600; }

    /* Progress bars and the habit heatmap, both straight from the tools. */
    .bar {
      height: 6px;
      border-radius: 999px;
      background: var(--bg-raised);
      overflow: hidden;
      margin: var(--space-1) 0 var(--space-2);
    }
    .bar > span { display: block; height: 100%; }
    .heat {
      display: grid;
      grid-template-columns: repeat(14, 1fr);
      gap: 3px;
      max-width: 260px;
    }
    .heat__cell { aspect-ratio: 1; border-radius: 2px; background: var(--bg-raised); }
    .heat__cell--on { background: var(--accent-6); }

    .board-note {
      max-width: 58ch;
      margin: var(--space-6) auto;
      text-align: center;
      font-size: 0.9em;
    }

    /* ── Topic: text beside a live widget ─────────────────────────────
       The demo column carries its own miniature board so the widget keeps the
       app's grid proportions instead of stretching to the text column. */
    .topic {
      display: grid;
      grid-template-columns: 1fr minmax(320px, 44%);
      gap: clamp(1.5rem, 4vw, 3.5rem);
      align-items: start;
      padding: clamp(3rem, 8vw, 5.5rem) 0;
      border-top: 1px solid var(--border-subtle);
    }
    .topic--flip .topic__text { order: 2; }
    .topic--wide { grid-template-columns: 1fr; }
    .topic__demo :global(.canvas) { padding: 0; }
    .topic__demo :global(.canvas-grid) { grid-template-columns: repeat(5, 1fr); }
    .topic__demo :global(.widget-frame) { grid-column: 1 / -1; }

    @media (max-width: 860px) {
      .topic { grid-template-columns: 1fr; }
      .topic--flip .topic__text { order: 0; }
    }

    /* ── Disclosure ───────────────────────────────────────────────────
       Reference material lives here so the page stays scannable: roughly
       6 500 words of documentation would otherwise be one wall. */
    .disc {
      border-top: 1px solid var(--border-subtle);
      padding: var(--space-3) 0;
    }
    .disc summary {
      cursor: pointer;
      font-weight: 600;
      font-size: 0.95em;
      list-style: none;
    }
    .disc summary::-webkit-details-marker { display: none; }
    .disc summary::before { content: '+ '; color: var(--accent); }
    .disc[open] summary::before { content: '– '; }
    .disc__body { color: var(--text-muted); font-size: 0.92em; padding-top: var(--space-2); }
    .disc__body p, .disc__body ul { margin: 0 0 var(--space-2); }
    .disc__body ul { padding-left: 1.1rem; }

    /* ── Tool list ────────────────────────────────────────────────────── */
    .tools {
      list-style: none;
      margin: var(--space-5) 0 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: var(--space-1) var(--space-4);
    }
    .tools__item {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      font-size: 0.9em;
      color: var(--text-muted);
      padding: 3px 0;
    }
    .tools__dot {
      width: 6px; height: 6px; border-radius: 999px;
      background: var(--success); flex: none;
    }

    /* ── Download ─────────────────────────────────────────────────────── */
    .installs {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--space-5);
      margin: var(--space-6) 0;
    }
    .install h3 { margin: 0 0 var(--space-2); font-size: 0.95em; font-weight: 600; }

    .steps { color: var(--text-muted); max-width: 64ch; padding-left: 1.2rem; }
    .steps li { margin-bottom: var(--space-3); }
    .steps strong { color: var(--text); font-weight: 600; }
  </style>

  <script>
    // A clock that never moves reads as a screenshot; one that ticks reads as
    // software. Minutes only — seconds would pull the eye off the headline.
    const clock = document.querySelector<HTMLElement>('[data-clock]');
    const date = document.querySelector<HTMLElement>('[data-date]');
    if (clock) {
      const tick = (): void => {
        const now = new Date();
        clock.textContent = `${String(now.getHours()).padStart(2, '0')}:${String(
          now.getMinutes(),
        ).padStart(2, '0')}`;
        if (date) {
          date.textContent = now.toLocaleDateString(undefined, {
            weekday: 'long',
            day: 'numeric',
            month: 'long',
          });
        }
      };
      tick();
      window.setInterval(tick, 20_000);
    }
  </script>
</Base>
